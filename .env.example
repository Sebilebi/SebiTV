# ==============================================================================
# SebiTV — Configuración de Entorno (Proxmox d-media / Dockhand)
# Copia este archivo como `.env` o define estas variables en tu Stack de Dockhand
# ==============================================================================

# Zona horaria y permisos (coinciden con tu stack actual)
TZ=Europe/Madrid
PUID=1000
PGID=1000

# ------------------------------------------------------------------------------
# 1. Catálogo Global (TMDB) — OBLIGATORIO para películas y series en español
# Consigue tu API Key gratuita en: https://www.themoviedb.org/settings/api
# (Acepta tanto la "Clave de la API (v3 auth)" como el "Token de acceso de lectura (v4)")
# ------------------------------------------------------------------------------
TMDB_API_KEY=PON_AQUI_TU_API_KEY_DE_TMDB

# ------------------------------------------------------------------------------
# 2. Conexión con Jellyfin (se autoconfigura al arrancar)
# Pon tu usuario y contraseña de administrador de Jellyfin (o JELLYFIN_API_KEY)
# ------------------------------------------------------------------------------
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_USER=Sebilebi
JELLYFIN_PASS=PON_AQUI_TU_PASSWORD_DE_JELLYFIN
JELLYFIN_API_KEY=

# Puerto público del motor SebiTV al que se conectará la interfaz de Jellyfin
SEBITV_PORT=8099
# Opcional: URL pública si algún día accedes desde fuera con dominio/HTTPS
SEBITV_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 3. Cliente Torrent (qBittorrent — preconfigurado automáticamente en red local)
# ------------------------------------------------------------------------------
QBIT_URL=http://qbittorrent:8080
QBIT_USER=admin
QBIT_PASS=

# ------------------------------------------------------------------------------
# 4. Fuentes de Torrents (ext.to + Nyaa para Anime + Prowlarr opcional)
# ------------------------------------------------------------------------------
EXT_BASE_URL=https://ext.to
# Opcional: si Cloudflare bloquea la IP del servidor en ext.to, puedes pegar
# aquí el valor del header Cookie de tu navegador (ej. cf_clearance=...; PHPSESSID=...)
EXT_COOKIE=
EXT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36

# Nyaa (activo por defecto como fuente directa sin captcha para Anime MultiSub)
NYAA_ENABLED=true
NYAA_BASE_URL=https://nyaa.si

# Prowlarr opcional (si añades Prowlarr para sumar más trackers en Castellano)
PROWLARR_URL=
PROWLARR_API_KEY=

# OpenSubtitles / Subdl opcional para subtítulos externos si un MKV de anime no los trae
SUBDL_API_KEY=

# ------------------------------------------------------------------------------
# 5. Ventana Deslizante y Gestión de Espacio en Disco (120 GB VM)
# ------------------------------------------------------------------------------
# Cuántos capítulos mantener hacia atrás y pre-descargar hacia adelante
WINDOW_BEHIND=1
WINDOW_AHEAD=1

# Horas tras terminar de ver una película no fijada para limpiar su archivo (0 = no borrar películas)
MOVIE_RETENTION_HOURS=48

# Intervalo de monitorización de sesiones y descargas (segundos)
POLL_INTERVAL_SECONDS=5

# ------------------------------------------------------------------------------
# 6. Acceso Remoto Zero-Trust Opcional (Authentik OIDC + Proxy Unificado)
# Si expones el puerto 8099 tras un túnel/dominio público, devolverá 404 vacío
# salvo a los navegadores con sesión aprobada en tu instancia de Authentik.
# ------------------------------------------------------------------------------
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_AUTHORIZE_URL=
AUTHENTIK_INTERNAL_URL=
AUTHENTIK_REQUIRED_GROUP=
